# Copy this file to .env.local and fill in your values.
# These stay on the server — they are never exposed to the browser.

# Required: your Anthropic API key (from console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: password-protect the app. Protection turns on only when
# APP_PASSWORD is set. APP_USERNAME defaults to "team" if omitted.
APP_PASSWORD=
APP_USERNAME=team
